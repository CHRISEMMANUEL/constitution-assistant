{
  "us": {
    "status": "ready",
    "adapter": "us-archives",
    "pages": [
      "https://www.archives.gov/founding-docs/constitution-transcript",
      "https://www.archives.gov/founding-docs/bill-of-rights-transcript",
      "https://www.archives.gov/founding-docs/amendments-11-27"
    ],
    "source_name": "U.S. National Archives",
    "source_url": "https://www.archives.gov/founding-docs/constitution",
    "license": "Public domain (U.S. Government work)",
    "language": "en",
    "official_translation": null,
    "expect": {
      "min": 50,
      "max": 80,
      "contains": ["Preamble", "Article I, Section 8", "Article V", "Amendment I", "Amendment XIV, Section 1", "Amendment XXVII"]
    }
  },
  "au": {
    "status": "ready",
    "adapter": "au-wikisource",
    "pages": ["Commonwealth of Australia Constitution Act (2013)"],
    "source_name": "Commonwealth of Australia Constitution Act, compilation as at 2013 (Federal Register of Legislation, transcribed on Wikisource)",
    "source_url": "https://www.legislation.gov.au/C2004Q00685/latest/text",
    "license": "CC BY 4.0 (Commonwealth of Australia)",
    "language": "en",
    "official_translation": null,
    "expect": {
      "min": 130,
      "max": 145,
      "contains": ["Preamble", "Covering clause 9", "Section 105A", "Schedule"],
      "sequence": { "prefix": "Section ", "from": 1, "to": 128 }
    }
  },
  "ke": {
    "status": "ready",
    "adapter": "ke-wikisource",
    "pages": ["Constitution of Kenya (2010)"],
    "source_name": "Constitution of Kenya, 2010 (official print, transcribed on Wikisource)",
    "source_url": "https://new.kenyalaw.org/akn/ke/act/2010/constitution/eng@2010-09-03",
    "license": "Public domain (written law is excluded from copyright, Kenya Copyright Act 2001)",
    "language": "en",
    "official_translation": null,
    "expect": {
      "min": 290,
      "max": 320,
      "contains": ["Preamble", "Sixth Schedule, section 1"],
      "sequence": { "prefix": "Article ", "from": 1, "to": 264 }
    }
  },
  "in": {
    "status": "ready",
    "adapter": "in-legislative",
    "pages": ["https://www.legislative.gov.in/cms/wp-json/post-page/post?id=18322"],
    "source_name": "The Constitution of India (English version, Legislative Department, Ministry of Law and Justice)",
    "source_url": "https://www.legislative.gov.in/constitution-of-india/",
    "license": "Free to reproduce (Indian Copyright Act 1957, s. 52(1)(q): publishing an Act of a Legislature is not infringement)",
    "language": "en",
    "official_translation": null,
    "expect": {
      "min": 540,
      "max": 580,
      "contains": ["Preamble", "Article 2A", "Article 21A", "Article 243ZT", "Article 394A", "First Schedule", "Sixth Schedule, paragraph 21", "Seventh Schedule, List III", "Tenth Schedule, paragraph 8", "Twelfth Schedule"],
      "sequence": { "prefix": "Article ", "from": 1, "to": 395, "absent": [238] }
    }
  },
  "za": {
    "status": "ready",
    "adapter": "za-justice",
    "pages": [
      "https://www.justice.gov.za/constitution/preamble.html",
      "https://www.justice.gov.za/constitution/chp01.html",
      "https://www.justice.gov.za/constitution/chp02.html",
      "https://www.justice.gov.za/constitution/chp03.html",
      "https://www.justice.gov.za/constitution/chp04.html",
      "https://www.justice.gov.za/constitution/chp05.html",
      "https://www.justice.gov.za/constitution/chp06.html",
      "https://www.justice.gov.za/constitution/chp07.html",
      "https://www.justice.gov.za/constitution/chp08.html",
      "https://www.justice.gov.za/constitution/chp09.html",
      "https://www.justice.gov.za/constitution/chp10.html",
      "https://www.justice.gov.za/constitution/chp11.html",
      "https://www.justice.gov.za/constitution/chp12.html",
      "https://www.justice.gov.za/constitution/chp13.html",
      "https://www.justice.gov.za/constitution/chp14.html",
      "https://www.justice.gov.za/constitution/SAConstitution-web-eng-s-a-combined.pdf"
    ],
    "source_name": "Constitution of the Republic of South Africa, 1996 (Department of Justice and Constitutional Development)",
    "source_url": "https://www.justice.gov.za/constitution/",
    "license": "Public domain (official legislative text, no copyright under s. 12(8)(a) of the Copyright Act 98 of 1978)",
    "language": "en",
    "official_translation": null,
    "expect": {
      "min": 290,
      "max": 320,
      "contains": ["Preamble", "Section 230A", "Schedule 1", "Schedule 3, Part A, item 9", "Schedule 6, item 28", "Schedule 6, Annexure D", "Schedule 7"],
      "sequence": { "prefix": "Section ", "from": 1, "to": 243 }
    }
  },
  "ng": {
    "status": "blocked",
    "reason": "No reachable official text. Wikisource copy has no source and an unknown version; nass.gov.ng, placng.org and nigeria-law.org time out from here. Keeps Constitute (CC BY-NC; the app is free and non-commercial)."
  },
  "gh": {
    "status": "blocked",
    "reason": "Wikisource copy is marked incomplete; judicial.gov.gh times out from here. Keeps Constitute (CC BY-NC; the app is free and non-commercial)."
  },
  "jm": {
    "status": "blocked",
    "reason": "Not on Wikisource; laws.moj.gov.jm returns 503 from here. Keeps Constitute (CC BY-NC; the app is free and non-commercial)."
  }
}
